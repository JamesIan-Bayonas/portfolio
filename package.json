{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "content:edit": "node --experimental-strip-types scripts/content-editor.mjs",
    "images:generate": "node scripts/generate-screenshots.mjs",
    "briefs:generate": "node scripts/generate-project-briefs.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "preview:release": "node scripts/release-preview.mjs",
    "verify:preview": "node scripts/release-preview.mjs --verify",
    "verify:release": "npm run check && npm test && npm run build && npm run verify:build && npm run verify:preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "motion": "^13.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "sharp": "0.34.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
